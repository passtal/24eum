# ================================================
# 24eum - Secret Properties (Example)
# 실제 사용 시 application-secret.properties 로 복사한 뒤 값 채우기
# .gitignore 에 의해 application-secret.properties 는 커밋되지 않음
# ================================================

# Kakao OAuth2
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao

# OpenAI API (AI 검색 / MCP)
openai.api.key=sk-your-openai-key
